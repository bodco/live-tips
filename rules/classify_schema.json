{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "livetips/classify_schema.json",
  "title": "Output of the classify role",
  "type": "object",
  "properties": {
    "need_tip": {
      "type": "boolean"
    },
    "level": {
      "enum": [
        "red",
        "orange",
        "none"
      ]
    },
    "trigger": {
      "enum": [
        "your_turn",
        "direct_question",
        "new_requirement",
        "pm_commitment",
        "contradicts_decision",
        "frustration",
        "scope_pushback",
        "value_doubt",
        "pm_factual_error",
        "fix_owner_date",
        "add_fact",
        "answer_in_primary",
        "side_talk",
        "question_any",
        "reflect",
        "none"
      ]
    },
    "topic": {
      "type": "string",
      "maxLength": 120
    },
    "reason": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "need_tip",
    "level",
    "trigger"
  ],
  "additionalProperties": false
}
