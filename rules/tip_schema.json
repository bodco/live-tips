{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "livetips/tip_schema.json",
  "title": "Live Tips window item",
  "description": "One line of <stem>.tips.jsonl. Written by the skill (via read_delta) or by the app. A tip reads as key / detail / source: 'gist' is the key line (first in model output so it can be shown while streaming), 'detail' the quieter line under it, 'phrase' the ready sentence, 'source' the document it comes from.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "enum": [
        "tip",
        "answer",
        "fact",
        "card",
        "speech",
        "checklist",
        "agenda",
        "status",
        "wrapup",
        "ack",
        "info",
        "speaker_ask",
        "question",
        "outline",
        "outline_pos",
        "situation",
        "facts",
        "state",
        "retract"
      ]
    },
    "gist": {
      "type": "string",
      "maxLength": 160
    },
    "detail": {
      "type": "string",
      "maxLength": 300,
      "description": "Theme pass stage 3 (2026-11-19): the quieter second line under the key line (gist): 1-2 plain sentences of context. Replaces why, which is still read."
    },
    "why": {
      "type": "string",
      "maxLength": 300,
      "description": "Legacy name of detail (2026-11-05 to 2026-11-19), still read."
    },
    "source": {
      "type": "string",
      "maxLength": 160,
      "description": "Theme pass stage 3 (2026-11-19): where the tip comes from, a document or call and its date (\"Release plan · Nov 14\"). Older items carry it in note."
    },
    "level": {
      "enum": [
        "red",
        "orange",
        "info"
      ]
    },
    "phrase": {
      "type": "string",
      "maxLength": 400
    },
    "items": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 200
          },
          {
            "type": "object"
          }
        ]
      },
      "maxItems": 12
    },
    "note": {
      "type": "string",
      "maxLength": 120
    },
    "q": {
      "type": "string"
    },
    "t": {
      "type": "string",
      "pattern": "^\\d\\d:\\d\\d:\\d\\d$"
    },
    "src": {
      "type": "string",
      "pattern": "^\\d\\d:\\d\\d:\\d\\d$"
    },
    "at": {
      "type": "string"
    },
    "late": {
      "type": "boolean"
    },
    "topic": {
      "type": "string",
      "maxLength": 80
    },
    "trigger": {
      "type": "string"
    },
    "fact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "engine": {
      "enum": [
        "skill",
        "app"
      ]
    },
    "key": {
      "type": "string"
    },
    "value": {},
    "uid": {
      "type": "string",
      "description": "Streamed tips: a later item with the same uid replaces this card; kind retract removes it."
    },
    "partial": {
      "type": "boolean",
      "description": "Only the gist so far; the full tip follows with the same uid."
    }
  },
  "required": [
    "kind"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "tip",
              "answer",
              "fact"
            ]
          }
        }
      },
      "then": {
        "required": [
          "gist",
          "src"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tip"
          }
        }
      },
      "then": {
        "required": [
          "level"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "answer"
          }
        }
      },
      "then": {
        "required": [
          "q"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ack"
          }
        }
      },
      "then": {
        "required": [
          "key"
        ]
      }
    }
  ]
}
